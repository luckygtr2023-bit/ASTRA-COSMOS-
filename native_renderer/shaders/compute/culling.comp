#version 450
// GPU Culling — frustum + occlusion + distance, HLOD 32 clusters
layout(local_size_x=64) in;
layout(set=0,binding=0) readonly buffer Bounds { vec4 aabb_min[]; vec4 aabb_max[]; } bounds;
layout(set=0,binding=1) buffer OutMask { uint mask[]; } outMask;
layout(set=0,binding=2) uniform CullingUBO {
    mat4 view_proj;
    vec3 cam_pos;
    float cull_dist;
    uint count;
} ubo;

bool frustum_cull(vec3 center, vec3 half){
    vec4 c = ubo.view_proj * vec4(center,1.0);
    // simplified: NDC check
    float r = max(half.x, max(half.y, half.z));
    return abs(c.x) > c.w + r || abs(c.y) > c.w + r || c.z < -c.w - r;
}
void main(){
    uint id = gl_GlobalInvocationID.x;
    if(id >= ubo.count) return;
    vec3 mn = bounds.aabb_min[id].xyz;
    vec3 mx = bounds.aabb_max[id].xyz;
    vec3 cen = (mn+mx)*0.5;
    vec3 half = (mx-mn)*0.5;
    bool culled = frustum_cull(cen, half) || length(cen - ubo.cam_pos) > ubo.cull_dist;
    outMask.mask[id] = culled ? 0u : 1u;
}
