#version 450
// Impact Spark — GPU particles RANDOM_SEED deterministic, AAA 1M
layout(local_size_x=64) in;
layout(set=0,binding=0) buffer Particles { vec4 pos_vel[]; vec4 color_life[]; } particles;
layout(set=0,binding=1) uniform Params { float dt; uint seed; uint count; } params;
// Deterministic hash vs RANDOM_SEED
float hash(uint x){ return fract(sin(float(x)*12.9898)*43758.5453); }
void main(){
    uint id = gl_GlobalInvocationID.x;
    if(id >= params.count) return;
    uint seed = params.seed + id*1664525u + 1013904223u;
    vec3 vel = vec3(hash(seed), hash(seed+1u), hash(seed+2u))*2.0-1.0;
    vec3 pos = particles.pos_vel[id].xyz + vel * params.dt;
    float life = particles.color_life[id].w - params.dt;
    particles.pos_vel[id] = vec4(pos, 0);
    particles.color_life[id].w = life;
}
